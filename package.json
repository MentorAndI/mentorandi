{
  "name": "mentorandi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "prelint": "prisma generate",
    "lint": "eslint",
    "check:env": "node scripts/check-env.mjs",
    "deploy:staging": "bash scripts/deploy-staging.sh",
    "setup:stripe:staging": "node scripts/setup-stripe-staging.mjs",
    "eval:models": "node scripts/eval-models.mjs",
    "eval:mentor": "node scripts/eval-mentor.mjs",
    "eval:mentor-specialization": "prisma generate && jiti scripts/eval-mentor-specialization.ts",
    "alpha:readiness": "node scripts/alpha-readiness-check.mjs",
    "smoke:alpha": "node scripts/alpha-smoke-test.mjs",
    "smoke:prod": "node scripts/production-smoke-test.mjs",
    "test:credits": "prisma generate && node scripts/run-credit-pricing-test.mjs",
    "test:mentor-scope": "node scripts/run-mentor-scope-test.mjs",
    "test:mentor-display-name": "node scripts/run-mentor-display-name-test.mjs",
    "test:auth-contract": "node scripts/run-auth-contract-test.mjs",
    "test:mentor-access": "node scripts/run-mentor-access-test.mjs",
    "prisma": "prisma",
    "db:seed": "prisma generate && jiti prisma/seed.ts",
    "import:mentor-specialization": "prisma generate && jiti scripts/import-mentor-specialization.ts",
    "test:mentor-specialization": "prisma generate && jiti tests/mentor-specialization/mentor-specialist-runtime.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.0",
    "lucide-react": "^1.22.0",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jiti": "^2.7.0",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
