generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MessageRole {
  USER
  MENTOR
  SYSTEM
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum FeedbackRating {
  USEFUL
  NEUTRAL
  NOT_USEFUL
}

enum FeedbackCategory {
  BUG
  CONFUSING
  MENTOR_QUALITY
  IDEA
  OTHER
}

enum UsageEventStatus {
  SUCCESS
  FAILURE
  BLOCKED
}

enum SubscriptionPlan {
  ALPHA
  FREE
  PERSONAL
  PREMIUM
  FOUNDER
}

enum SubscriptionStatus {
  INACTIVE
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  authUserId String   @unique @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  conversations    Conversation[]
  feedback         Feedback[]
  goals            Goal[]
  journalEntries   JournalEntry[]
  memories         Memory[]
  reflections      Reflection[]
  usageEvents      UsageEvent[]
  alphaInvitesUsed AlphaInvite[]  @relation("AlphaInviteUsedBy")
  subscription     Subscription?

  @@index([createdAt])
}

model Subscription {
  id                    String             @id @default(uuid()) @db.Uuid
  userId                String             @unique @db.Uuid
  plan                  SubscriptionPlan   @default(ALPHA)
  status                SubscriptionStatus @default(INACTIVE)
  billingProvider       String?            @db.VarChar(32)
  billingCustomerId     String?            @unique @db.VarChar(255)
  billingSubscriptionId String?            @unique @db.VarChar(255)
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([plan, status])
  @@index([status, currentPeriodEnd])
  @@index([createdAt])
}

model AlphaInvite {
  id           String    @id @default(uuid()) @db.Uuid
  codeHash     String    @unique @db.VarChar(64)
  codePreview  String    @db.VarChar(32)
  email        String?   @db.VarChar(320)
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?
  usedAt       DateTime?
  usedByUserId String?   @db.Uuid
  revokedAt    DateTime?
  maxUses      Int       @default(1)
  useCount     Int       @default(0)
  note         String?

  usedByUser User? @relation("AlphaInviteUsedBy", fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([email])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([usedByUserId])
}

model Feedback {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  rating    FeedbackRating
  category  FeedbackCategory
  message   String
  pagePath  String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

model Mentor {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conversations Conversation[]
  usageEvents   UsageEvent[]

  @@index([active])
  @@index([slug])
}

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  mentorId  String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  mentor      Mentor       @relation(fields: [mentorId], references: [id], onDelete: Restrict)
  memories    Memory[]     @relation("ConversationMemories")
  messages    Message[]
  usageEvents UsageEvent[]

  @@index([userId])
  @@index([mentorId])
  @@index([userId, updatedAt])
  @@index([mentorId, updatedAt])
}

model UsageEvent {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @db.Uuid
  mentorId         String?          @db.Uuid
  conversationId   String?          @db.Uuid
  provider         String?
  model            String?
  route            String?
  inputTokens      Int?
  outputTokens     Int?
  totalTokens      Int?
  estimatedCostUsd Decimal?         @db.Decimal(14, 8)
  status           UsageEventStatus
  errorCode        String?
  createdAt        DateTime         @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mentor       Mentor?       @relation(fields: [mentorId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
  @@index([provider, createdAt])
  @@index([model, createdAt])
  @@index([mentorId, createdAt])
  @@index([conversationId, createdAt])
  @@index([route, createdAt])
  @@index([createdAt])
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @db.Uuid
  role           MessageRole
  content        String
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([role])
}

model Memory {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @db.Uuid
  category             String
  title                String
  content              String
  importance           Int      @default(3)
  confidence           Float    @default(0.5)
  sourceConversationId String?  @db.Uuid
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceConversation Conversation? @relation("ConversationMemories", fields: [sourceConversationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, category])
  @@index([userId, importance])
  @@index([sourceConversationId])
}

model Goal {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  title       String
  description String?
  status      GoalStatus @default(ACTIVE)
  targetDate  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([userId, targetDate])
}

model Reflection {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  summary   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

model JournalEntry {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String
  content   String
  mood      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, mood])
}
