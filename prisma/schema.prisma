generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MessageRole {
  USER
  MENTOR
  SYSTEM
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum MentorNoteType {
  TECHNIQUE
  PRACTICE
  PLAN
  REMEMBER
}

enum FeedbackRating {
  USEFUL
  NEUTRAL
  NOT_USEFUL
}

enum FeedbackCategory {
  BUG
  CONFUSING
  MENTOR_QUALITY
  ONBOARDING
  PRICING
  IDEA
  OTHER
}

enum UsageEventStatus {
  SUCCESS
  FAILURE
  BLOCKED
}

enum CreditTransactionType {
  STARTER_GRANT
  PLAN_RESET
  PLAN_GRANT
  USAGE_DEBIT
  TOP_UP
  ADJUSTMENT
}

enum SubscriptionPlan {
  ALPHA
  FREE
  PERSONAL
  SINGLE
  PLUS
  PREMIUM
  COMPANY_STRESS
  FOUNDER
}

enum SubscriptionStatus {
  INACTIVE
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum MentorSpecialistPackStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MentorSafetySeverity {
  NORMAL
  HIGH
  CRISIS
}

enum MentorEvalScenarioType {
  STANDARD
  REGRESSION
  SAFETY
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  authUserId String   @unique @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  conversations       Conversation[]
  creditAccount       CreditAccount?
  creditTransactions  CreditTransaction[]
  feedback            Feedback[]
  goals               Goal[]
  journalEntries      JournalEntry[]
  memories            Memory[]
  mentorNotes         MentorNote[]
  reflections         Reflection[]
  usageEvents         UsageEvent[]
  alphaInvitesUsed    AlphaInvite[]  @relation("AlphaInviteUsedBy")
  subscription        Subscription?

  @@index([createdAt])
}

model Subscription {
  id                    String             @id @default(uuid()) @db.Uuid
  userId                String             @unique @db.Uuid
  plan                  SubscriptionPlan   @default(ALPHA)
  status                SubscriptionStatus @default(INACTIVE)
  billingProvider       String?            @db.VarChar(32)
  billingCustomerId     String?            @unique @db.VarChar(255)
  billingSubscriptionId String?            @unique @db.VarChar(255)
  selectedMentorSlug    String?            @db.VarChar(64)
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([plan, status])
  @@index([selectedMentorSlug])
  @@index([status, currentPeriodEnd])
  @@index([createdAt])
}

model CreditAccount {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  planBalance     Decimal  @default(0) @db.Decimal(14, 2)
  topUpBalance    Decimal  @default(0) @db.Decimal(14, 2)
  periodKey       String?  @db.VarChar(255)
  lifetimeGranted Decimal  @default(0) @db.Decimal(14, 2)
  lifetimeUsed    Decimal  @default(0) @db.Decimal(14, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]

  @@index([updatedAt])
}

model CreditTransaction {
  id             String                @id @default(uuid()) @db.Uuid
  userId         String                @db.Uuid
  accountId      String                @db.Uuid
  type           CreditTransactionType
  amount         Decimal               @db.Decimal(14, 2)
  balanceAfter   Decimal               @db.Decimal(14, 2)
  apiCostUsd     Decimal?              @db.Decimal(14, 8)
  retailCostUsd  Decimal?              @db.Decimal(14, 8)
  provider       String?               @db.VarChar(32)
  model          String?               @db.VarChar(128)
  usageEventId   String?               @unique @db.Uuid
  idempotencyKey String                @unique @db.VarChar(255)
  createdAt      DateTime              @default(now())

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    CreditAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  usageEvent UsageEvent?    @relation(fields: [usageEventId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
}

model AlphaInvite {
  id           String    @id @default(uuid()) @db.Uuid
  codeHash     String    @unique @db.VarChar(64)
  codePreview  String    @db.VarChar(32)
  email        String?   @db.VarChar(320)
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?
  usedAt       DateTime?
  usedByUserId String?   @db.Uuid
  revokedAt    DateTime?
  maxUses      Int       @default(1)
  useCount     Int       @default(0)
  note         String?

  usedByUser User? @relation("AlphaInviteUsedBy", fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([email])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([usedByUserId])
}

model Feedback {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  rating      FeedbackRating
  ratingScore Int?
  category    FeedbackCategory
  message     String
  pagePath    String?
  mentorSlug  String?
  createdAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

model Mentor {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conversations   Conversation[]
  mentorNotes      MentorNote[]
  specialistPacks MentorSpecialistPack[]
  usageEvents     UsageEvent[]

  @@index([active])
  @@index([slug])
}

model MentorSpecialistPack {
  id          String                     @id @default(uuid()) @db.Uuid
  mentorId    String?                    @db.Uuid
  mentorSlug  String                     @db.VarChar(64)
  slug        String                     @db.VarChar(64)
  displayName String
  version     String                     @db.VarChar(32)
  status      MentorSpecialistPackStatus @default(DRAFT)
  description String
  sourcePath  String
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  mentor         Mentor?               @relation(fields: [mentorId], references: [id], onDelete: SetNull)
  techniques     MentorTechnique[]
  knowledgeCards MentorKnowledgeCard[]
  sources        MentorSource[]
  safetyRules    MentorSafetyRule[]
  evalScenarios  MentorEvalScenario[]

  @@unique([slug, version])
  @@index([mentorSlug, status])
  @@index([mentorId])
}

model MentorTechnique {
  id            String               @id @default(uuid()) @db.Uuid
  packId        String               @db.Uuid
  slug          String               @db.VarChar(128)
  title         String
  summary       String
  whenToUse     String
  stepsJson     Json
  mentorWording String
  tags          String[]
  priority      Int                  @default(0)
  sourcePath    String
  version       String               @db.VarChar(32)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  pack          MentorSpecialistPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@unique([packId, slug])
  @@index([packId, priority])
}

model MentorKnowledgeCard {
  id             String               @id @default(uuid()) @db.Uuid
  packId         String               @db.Uuid
  slug           String               @db.VarChar(128)
  title          String
  summary        String
  body           String
  tags           String[]
  selectionHints String[]
  sourceRefs     String[]
  priority       Int                  @default(0)
  sourcePath     String
  version        String               @db.VarChar(32)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  pack           MentorSpecialistPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@unique([packId, slug])
  @@index([packId, priority])
}

model MentorSource {
  id             String               @id @default(uuid()) @db.Uuid
  packId         String               @db.Uuid
  slug           String               @db.VarChar(128)
  title          String
  url            String?
  publisher      String
  sourceType     String
  usage          String
  trustLevel     String
  refreshCadence String
  notes          String
  sourcePath     String
  version        String               @db.VarChar(32)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  pack           MentorSpecialistPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@unique([packId, slug])
  @@index([packId])
}

model MentorSafetyRule {
  id                       String               @id @default(uuid()) @db.Uuid
  packId                   String               @db.Uuid
  slug                     String               @db.VarChar(128)
  title                    String
  rule                     String
  triggerPatterns          String[]
  requiredResponseBehavior String
  severity                 MentorSafetySeverity @default(NORMAL)
  sourcePath               String
  version                  String               @db.VarChar(32)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  pack                     MentorSpecialistPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@unique([packId, slug])
  @@index([packId, severity])
}

model MentorEvalScenario {
  id                String                 @id @default(uuid()) @db.Uuid
  packId            String                 @db.Uuid
  slug               String                 @db.VarChar(128)
  title              String
  userPrompt         String
  expectedBehavior   String[]
  mustUse            String[]
  mustAvoid          String[]
  safetyExpectation  String
  scenarioType       MentorEvalScenarioType @default(STANDARD)
  sourcePath         String
  version            String                 @db.VarChar(32)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  pack               MentorSpecialistPack   @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@unique([packId, slug])
  @@index([packId, scenarioType])
}

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  mentorId  String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  mentor      Mentor       @relation(fields: [mentorId], references: [id], onDelete: Restrict)
  memories    Memory[]     @relation("ConversationMemories")
  mentorNotes MentorNote[]
  messages    Message[]
  usageEvents UsageEvent[]

  @@index([userId])
  @@index([mentorId])
  @@index([userId, updatedAt])
  @@index([mentorId, updatedAt])
}

model MentorNote {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  mentorId       String         @db.Uuid
  conversationId String?        @db.Uuid
  type           MentorNoteType
  title          String         @db.VarChar(120)
  content        String
  pinned         Boolean        @default(false)
  archivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mentor       Mentor        @relation(fields: [mentorId], references: [id], onDelete: Restrict)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, archivedAt, pinned, createdAt])
  @@index([mentorId, createdAt])
  @@index([conversationId])
}

model UsageEvent {
  id                       String           @id @default(uuid()) @db.Uuid
  userId                   String           @db.Uuid
  mentorId                 String?          @db.Uuid
  conversationId           String?          @db.Uuid
  provider                 String?
  model                    String?
  route                    String?
  inputTokens              Int?
  cachedInputTokens        Int?
  outputTokens             Int?
  totalTokens              Int?
  estimatedCostUsd         Decimal?         @db.Decimal(14, 8)
  status                   UsageEventStatus
  errorCode                String?
  specialistPackSlug       String?          @db.VarChar(64)
  specialistPackName       String?
  specialistPackVersion    String?          @db.VarChar(32)
  selectedTechniqueSlugs   String[]         @default([])
  selectedTechniqueTitles  String[]         @default([])
  selectedKnowledgeSlugs   String[]         @default([])
  selectedKnowledgeTitles  String[]         @default([])
  selectedSafetyRuleSlugs  String[]         @default([])
  selectedSafetyRuleTitles String[]         @default([])
  specialistPromptTokens   Int?
  createdAt                DateTime         @default(now())

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  mentor            Mentor?            @relation(fields: [mentorId], references: [id], onDelete: SetNull)
  conversation      Conversation?      @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  creditTransaction CreditTransaction?

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
  @@index([provider, createdAt])
  @@index([model, createdAt])
  @@index([mentorId, createdAt])
  @@index([conversationId, createdAt])
  @@index([route, createdAt])
  @@index([specialistPackSlug, createdAt])
  @@index([createdAt])
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @db.Uuid
  role           MessageRole
  content        String
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([role])
}

model Memory {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @db.Uuid
  category             String
  title                String
  content              String
  importance           Int      @default(3)
  confidence           Float    @default(0.5)
  sourceConversationId String?  @db.Uuid
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceConversation Conversation? @relation("ConversationMemories", fields: [sourceConversationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, category])
  @@index([userId, importance])
  @@index([sourceConversationId])
}

model Goal {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  title       String
  description String?
  status      GoalStatus @default(ACTIVE)
  targetDate  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([userId, targetDate])
}

model Reflection {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  summary   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

model JournalEntry {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String
  content   String
  mood      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, mood])
}
